#include "/TDFluidGpu/Private/TDFluidGpuCommon.ush"

#define TDFLUIDGPU_VORTICITY_HALO_CELLS 2
#define TDFLUIDGPU_VORTICITY_VELOCITY_TILE (TDFLUIDGPU_TILE_GROUP_SIZE + 2 * TDFLUIDGPU_VORTICITY_HALO_CELLS)
#define TDFLUIDGPU_VORTICITY_CURL_TILE (TDFLUIDGPU_TILE_GROUP_SIZE + 2)
#define TDFLUIDGPU_VORTICITY_THREAD_COUNT (TDFLUIDGPU_TILE_GROUP_SIZE * TDFLUIDGPU_TILE_GROUP_SIZE)

Texture2DArray<float> ObstacleSdf;
Texture2DArray<float> TerrainElevation;
Texture2DArray<float2> VelocityIn;
Texture2DArray<float2> DensityIn;
Texture2DArray<float> HeatIn;
RWTexture2DArray<float2> VelocityOut;

groupshared float2 SharedVorticityVelocity[TDFLUIDGPU_VORTICITY_VELOCITY_TILE * TDFLUIDGPU_VORTICITY_VELOCITY_TILE];
groupshared float SharedVorticityCurl[TDFLUIDGPU_VORTICITY_CURL_TILE * TDFLUIDGPU_VORTICITY_CURL_TILE];

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void ForcesCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[DispatchThreadId.z];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	if (TDFluidGpuIsSolidDistance(ObstacleSdf[Texel]))
	{
		VelocityOut[Texel] = float2(0.0f, 0.0f);
		return;
	}

	float2 Velocity = VelocityIn[Texel];
	const float2 Density = DensityIn[Texel];
	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_TERRAIN_SLOPE_ACCELERATION))
	{
		const float2 TerrainSlope = TDFluidGpuComputeTerrainSlope(TerrainElevation, Actor, Cell);
		const float ActiveFluidMask = clamp(Density.x + Density.y + 0.1f, 0.0f, 1.0f);
		Velocity -= TerrainSlope * Actor.TerrainSlopeGravity * ActiveFluidMask * Actor.StepDeltaTimeSeconds;
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_FLOW_NOISE))
	{
		Velocity += TDFluidGpuEvaluateFlowNoiseAcceleration(Actor, Cell) * Actor.StepDeltaTimeSeconds;
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_BUOYANCY))
	{
		const float ExcessDensity = max(0.0f, max(Density.x, Density.y) - Actor.AmbientDensity);
		Velocity += Actor.BuoyancyVelocityStepCmPerSec * ExcessDensity;
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_HEAT_CHANNEL))
	{
		Velocity += Actor.HeatBuoyancyVelocityStepCmPerSec * HeatIn[Texel];
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_VORTEX_FORCE))
	{
		Velocity += TDFluidGpuComputeVortexTangentialStep(Actor, Cell);
	}

	VelocityOut[Texel] = TDFluidGpuEnforceObstacleBoundary(ObstacleSdf, Actor, Cell, Velocity);
}

uint ToVorticityVelocityIndex(int2 LocalCell)
{
	return uint(LocalCell.y * TDFLUIDGPU_VORTICITY_VELOCITY_TILE + LocalCell.x);
}

uint ToVorticityCurlIndex(int2 LocalCell)
{
	return uint(LocalCell.y * TDFLUIDGPU_VORTICITY_CURL_TILE + LocalCell.x);
}

[numthreads(TDFLUIDGPU_TILE_GROUP_SIZE, TDFLUIDGPU_TILE_GROUP_SIZE, 1)]
void VorticityCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[GroupId.z];
	const int Resolution = Actor.Resolution;
	const int2 TileOrigin = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE;

	for (uint VelocityIndex = GroupIndex; VelocityIndex < TDFLUIDGPU_VORTICITY_VELOCITY_TILE * TDFLUIDGPU_VORTICITY_VELOCITY_TILE; VelocityIndex += TDFLUIDGPU_VORTICITY_THREAD_COUNT)
	{
		const int2 LocalCell = int2(VelocityIndex % TDFLUIDGPU_VORTICITY_VELOCITY_TILE, VelocityIndex / TDFLUIDGPU_VORTICITY_VELOCITY_TILE);
		const int2 GlobalCell = TileOrigin - TDFLUIDGPU_VORTICITY_HALO_CELLS + LocalCell;
		float2 Velocity = float2(0.0f, 0.0f);
		if (TDFluidGpuIsInsideGrid(GlobalCell, Resolution))
		{
			Velocity = VelocityIn[TDFluidGpuMakeTexel(GlobalCell, Actor.SliceIndex)];
		}
		SharedVorticityVelocity[VelocityIndex] = Velocity;
	}
	GroupMemoryBarrierWithGroupSync();

	for (uint CurlIndex = GroupIndex; CurlIndex < TDFLUIDGPU_VORTICITY_CURL_TILE * TDFLUIDGPU_VORTICITY_CURL_TILE; CurlIndex += TDFLUIDGPU_VORTICITY_THREAD_COUNT)
	{
		const int2 LocalCell = int2(CurlIndex % TDFLUIDGPU_VORTICITY_CURL_TILE, CurlIndex / TDFLUIDGPU_VORTICITY_CURL_TILE);
		const int2 GlobalCell = TileOrigin - 1 + LocalCell;
		float Curl = 0.0f;
		const bool bIsInteriorCell = GlobalCell.x >= 1 && GlobalCell.y >= 1 && GlobalCell.x <= Resolution - 2 && GlobalCell.y <= Resolution - 2;
		if (bIsInteriorCell)
		{
			const int2 VelocityCell = LocalCell + 1;
			const float VelocityYRight = SharedVorticityVelocity[ToVorticityVelocityIndex(VelocityCell + int2(1, 0))].y;
			const float VelocityYLeft = SharedVorticityVelocity[ToVorticityVelocityIndex(VelocityCell - int2(1, 0))].y;
			const float VelocityXUp = SharedVorticityVelocity[ToVorticityVelocityIndex(VelocityCell + int2(0, 1))].x;
			const float VelocityXDown = SharedVorticityVelocity[ToVorticityVelocityIndex(VelocityCell - int2(0, 1))].x;
			const float VelocityYDerivativeX = 0.5f * (VelocityYRight - VelocityYLeft) / Actor.RelativeCellSpacing.x;
			const float VelocityXDerivativeY = 0.5f * (VelocityXUp - VelocityXDown) / Actor.RelativeCellSpacing.y;
			Curl = VelocityYDerivativeX - VelocityXDerivativeY;
		}
		SharedVorticityCurl[CurlIndex] = Curl;
	}
	GroupMemoryBarrierWithGroupSync();

	const int2 Cell = TileOrigin + int2(GroupThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Resolution))
	{
		return;
	}

	const int2 LocalVelocityCell = int2(GroupThreadId.xy) + TDFLUIDGPU_VORTICITY_HALO_CELLS;
	float2 Velocity = SharedVorticityVelocity[ToVorticityVelocityIndex(LocalVelocityCell)];
	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	const bool bIsConfinedCell = Cell.x >= 2 && Cell.y >= 2 && Cell.x <= Resolution - 3 && Cell.y <= Resolution - 3;
	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_VORTICITY) && bIsConfinedCell && !TDFluidGpuIsSolidDistance(ObstacleSdf[Texel]))
	{
		const int2 LocalCurlCell = int2(GroupThreadId.xy) + 1;
		const float AbsCurlRight = abs(SharedVorticityCurl[ToVorticityCurlIndex(LocalCurlCell + int2(1, 0))]);
		const float AbsCurlLeft = abs(SharedVorticityCurl[ToVorticityCurlIndex(LocalCurlCell - int2(1, 0))]);
		const float AbsCurlUp = abs(SharedVorticityCurl[ToVorticityCurlIndex(LocalCurlCell + int2(0, 1))]);
		const float AbsCurlDown = abs(SharedVorticityCurl[ToVorticityCurlIndex(LocalCurlCell - int2(0, 1))]);
		float2 CurlGradient = float2(
			0.5f * (AbsCurlRight - AbsCurlLeft) / Actor.RelativeCellSpacing.x,
			0.5f * (AbsCurlUp - AbsCurlDown) / Actor.RelativeCellSpacing.y);
		const float CurlGradientLengthSquared = dot(CurlGradient, CurlGradient);
		if (CurlGradientLengthSquared > TDFLUIDGPU_SMALL_NUMBER)
		{
			CurlGradient *= rsqrt(CurlGradientLengthSquared);
			const float Curl = SharedVorticityCurl[ToVorticityCurlIndex(LocalCurlCell)];
			Velocity.x += CurlGradient.y * Curl * Actor.VorticityStrength * Actor.StepDeltaTimeSeconds;
			Velocity.y += -CurlGradient.x * Curl * Actor.VorticityStrength * Actor.StepDeltaTimeSeconds;
		}
	}

	VelocityOut[Texel] = Velocity;
}

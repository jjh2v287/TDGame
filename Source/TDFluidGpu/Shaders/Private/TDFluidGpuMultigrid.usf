#include "/TDFluidGpu/Private/TDFluidGpuCommon.ush"

#ifndef TDFLUIDGPU_MG_IS_FINEST_LEVEL
#define TDFLUIDGPU_MG_IS_FINEST_LEVEL 0
#endif

#ifndef TDFLUIDGPU_MG_WRITES_COARSE_APERTURES
#define TDFLUIDGPU_MG_WRITES_COARSE_APERTURES 0
#endif

#ifndef TDFLUIDGPU_MG_WRITES_PRESSURE_PARTIAL_SUMS
#define TDFLUIDGPU_MG_WRITES_PRESSURE_PARTIAL_SUMS 0
#endif

#define TDFLUIDGPU_MG_REDUCES_PRESSURE_SUMS (TDFLUIDGPU_MG_IS_FINEST_LEVEL && TDFLUIDGPU_MG_WRITES_PRESSURE_PARTIAL_SUMS)

#define TDFLUIDGPU_MG_DOWN_HALF_SWEEP_COUNT 2
#define TDFLUIDGPU_MG_UP_HALF_SWEEP_COUNT 4
#define TDFLUIDGPU_MG_DOWN_HALO_CELLS (TDFLUIDGPU_MG_DOWN_HALF_SWEEP_COUNT + 1)
#define TDFLUIDGPU_MG_UP_HALO_CELLS TDFLUIDGPU_MG_UP_HALF_SWEEP_COUNT
#define TDFLUIDGPU_MG_DOWN_REGION (TDFLUIDGPU_TILE_GROUP_SIZE + 2 * TDFLUIDGPU_MG_DOWN_HALO_CELLS)
#define TDFLUIDGPU_MG_UP_REGION (TDFLUIDGPU_TILE_GROUP_SIZE + 2 * TDFLUIDGPU_MG_UP_HALO_CELLS)
#define TDFLUIDGPU_MG_LARGEST_REGION (TDFLUIDGPU_MG_DOWN_REGION > TDFLUIDGPU_MG_UP_REGION ? TDFLUIDGPU_MG_DOWN_REGION : TDFLUIDGPU_MG_UP_REGION)
#define TDFLUIDGPU_MG_REGION_CAPACITY (TDFLUIDGPU_MG_LARGEST_REGION * TDFLUIDGPU_MG_LARGEST_REGION)
#define TDFLUIDGPU_MG_THREAD_COUNT (TDFLUIDGPU_TILE_GROUP_SIZE * TDFLUIDGPU_TILE_GROUP_SIZE)
#define TDFLUIDGPU_MG_UP_THREAD_COUNT (TDFLUIDGPU_MG_UP_REGION * TDFLUIDGPU_MG_UP_REGION / 2)
#define TDFLUIDGPU_MG_COUNT_OWNED_SLOTS(RegionSize, ThreadCount) (((RegionSize) * (RegionSize) / 2 + (ThreadCount) - 1) / (ThreadCount))
#define TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT TDFLUIDGPU_MG_COUNT_OWNED_SLOTS(TDFLUIDGPU_MG_DOWN_REGION, TDFLUIDGPU_MG_THREAD_COUNT)
#define TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT TDFLUIDGPU_MG_COUNT_OWNED_SLOTS(TDFLUIDGPU_MG_UP_REGION, TDFLUIDGPU_MG_UP_THREAD_COUNT)
#define TDFLUIDGPU_MG_COARSE_FOOTPRINT TDFLUIDGPU_TILE_GROUP_SIZE
#define TDFLUIDGPU_MG_COARSE_FOOTPRINT_MARGIN 4

static const float TDFLUIDGPU_MG_PRESSURE_LIMIT = 1.0e6f;

Texture2DArray<float> ObstacleSdf;
Texture2DArray<float2> VelocityIn;
Texture2DArray<float> ValueIn;
Texture2DArray<float> RhsIn;
Texture2DArray<float2> AperturesIn;
Texture2DArray<float> CoarseCorrectionIn;
Texture2DArray<float2> CoarseAperturesIn;
RWTexture2DArray<float> ValueOut;
RWTexture2DArray<float> CoarseRhsOut;
RWTexture2DArray<float2> CoarseAperturesOut;
RWStructuredBuffer<float2> PressurePartialSumsOut;
uint TilesPerSlice;
uint TilesPerRow;
float LevelWeightScale;
float WarmStartScale;
int LevelResolution;

groupshared float SharedValue[TDFLUIDGPU_MG_REGION_CAPACITY];
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
groupshared float SharedVelocityX[TDFLUIDGPU_MG_REGION_CAPACITY];
groupshared float SharedVelocityY[TDFLUIDGPU_MG_REGION_CAPACITY];
groupshared uint SharedFluidCell[TDFLUIDGPU_MG_REGION_CAPACITY];
#else
groupshared float SharedRhs[TDFLUIDGPU_MG_REGION_CAPACITY];
groupshared float SharedApertureX[TDFLUIDGPU_MG_REGION_CAPACITY];
groupshared float SharedApertureY[TDFLUIDGPU_MG_REGION_CAPACITY];
#endif
groupshared float SharedResidual[TDFLUIDGPU_MG_THREAD_COUNT];
groupshared float SharedCoarseCorrection[TDFLUIDGPU_MG_THREAD_COUNT];
groupshared float2 SharedCoarseApertures[TDFLUIDGPU_MG_THREAD_COUNT];
#if TDFLUIDGPU_MG_REDUCES_PRESSURE_SUMS
groupshared float2 SharedPressureSums[TDFLUIDGPU_MG_THREAD_COUNT];
groupshared float2 SharedPressureColumnSums[TDFLUIDGPU_TILE_GROUP_SIZE];
#endif

struct FTDFluidGpuMultigridOwnedCell
{
	int2 LocalCell;
	uint ValueIndex;
	uint NeighborBase;
	uint ColumnParity;
	int WindowMargin;
	bool bIsOwned;
	bool bIsActive;
	float RightWeight;
	float LeftWeight;
	float UpWeight;
	float DownWeight;
	float Diagonal;
	float Rhs;
};

int2 ToLocalCell(uint RegionIndex, int RegionSize)
{
	return int2(int(RegionIndex) % RegionSize, int(RegionIndex) / RegionSize);
}

uint ToColorSplitIndex(int2 LocalCell, int RegionSize)
{
	const uint Plane = uint(LocalCell.x + LocalCell.y) & 1u;
	return Plane * uint(RegionSize * RegionSize / 2) + uint(LocalCell.y * (RegionSize / 2) + (LocalCell.x >> 1));
}

int GetLevelSlice(FTDFluidGpuActorParameters Actor, uint EntryIndex)
{
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	return Actor.SliceIndex;
#else
	return int(EntryIndex);
#endif
}

float2 ComputeLevelWeights(FTDFluidGpuActorParameters Actor)
{
	return float2(Actor.InvSpacingXSquared, Actor.InvSpacingYSquared) * LevelWeightScale;
}

void LoadRegion(FTDFluidGpuActorParameters Actor, uint EntryIndex, int2 RegionOrigin, int RegionSize, bool bLoadsValue, float ValueScale, uint GroupIndex, uint ThreadCount)
{
	const int Slice = GetLevelSlice(Actor, EntryIndex);
	const uint RegionCellCount = uint(RegionSize * RegionSize);
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	const int GridResolution = Actor.Resolution;
#else
	const int GridResolution = LevelResolution;
#endif
	const uint SlotCount = (RegionCellCount + ThreadCount - 1u) / ThreadCount;
	[unroll]
	for (uint Slot = 0; Slot < SlotCount; ++Slot)
	{
		const uint RegionIndex = GroupIndex + Slot * ThreadCount;
		const int2 LocalCell = ToLocalCell(min(RegionIndex, RegionCellCount - 1u), RegionSize);
		const int2 Cell = RegionOrigin + LocalCell;
		const bool bIsInside = TDFluidGpuIsInsideGrid(Cell, GridResolution);
		const uint3 Texel = TDFluidGpuMakeTexel(clamp(Cell, int2(0, 0), int2(GridResolution - 1, GridResolution - 1)), Slice);
		const uint SplitIndex = ToColorSplitIndex(LocalCell, RegionSize);
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
		const float SignedDistance = ObstacleSdf[Texel];
		const float2 LoadedVelocity = VelocityIn[Texel];
		const float LoadedValue = bLoadsValue ? ValueIn[Texel] : 0.0f;
		const bool bIsFluid = bIsInside && !TDFluidGpuIsSolidDistance(SignedDistance);
		if (RegionIndex < RegionCellCount)
		{
			SharedFluidCell[SplitIndex] = bIsFluid ? 1u : 0u;
			SharedVelocityX[SplitIndex] = bIsFluid ? LoadedVelocity.x : 0.0f;
			SharedVelocityY[SplitIndex] = bIsFluid ? LoadedVelocity.y : 0.0f;
			SharedValue[SplitIndex] = (bIsFluid && bLoadsValue) ? LoadedValue * ValueScale : 0.0f;
		}
#else
		const float LoadedRhs = RhsIn[Texel];
		const float2 LoadedApertures = AperturesIn[Texel];
		const float LoadedValue = bLoadsValue ? ValueIn[Texel] : 0.0f;
		if (RegionIndex < RegionCellCount)
		{
			SharedRhs[SplitIndex] = bIsInside ? LoadedRhs : 0.0f;
			SharedApertureX[SplitIndex] = bIsInside ? LoadedApertures.x : 0.0f;
			SharedApertureY[SplitIndex] = bIsInside ? LoadedApertures.y : 0.0f;
			SharedValue[SplitIndex] = (bIsInside && bLoadsValue) ? LoadedValue : 0.0f;
		}
#endif
	}
}

FTDFluidGpuMultigridOwnedCell MakeOwnedCell(FTDFluidGpuActorParameters Actor, float2 Weights, int RegionSize, uint Plane, uint Slot, uint GroupIndex, uint ThreadCount)
{
	const uint HalfRowCellCount = uint(RegionSize / 2);
	const uint PlaneCellCount = HalfRowCellCount * uint(RegionSize);
	const uint ColorIndex = GroupIndex + Slot * ThreadCount;
	const uint ClampedIndex = min(ColorIndex, PlaneCellCount - 1u);
	const uint Row = ClampedIndex / HalfRowCellCount;

	FTDFluidGpuMultigridOwnedCell Cell;
	Cell.bIsOwned = ColorIndex < PlaneCellCount;
	Cell.ColumnParity = (Plane + Row) & 1u;
	const uint Column = 2u * (ClampedIndex % HalfRowCellCount) + Cell.ColumnParity;
	Cell.LocalCell = int2(int(Column), int(Row));
	Cell.ValueIndex = Plane * PlaneCellCount + ClampedIndex;
	Cell.NeighborBase = (1u - Plane) * PlaneCellCount + ClampedIndex;
	Cell.WindowMargin = min(min(int(Column), int(Row)), min(RegionSize - 1 - int(Column), RegionSize - 1 - int(Row)));

	const bool bHasRight = int(Column) + 1 < RegionSize;
	const bool bHasLeft = Column > 0u;
	const bool bHasUp = int(Row) + 1 < RegionSize;
	const bool bHasDown = Row > 0u;
	const uint RightIndex = bHasRight ? Cell.NeighborBase + Cell.ColumnParity : Cell.ValueIndex;
	const uint LeftIndex = bHasLeft ? Cell.NeighborBase + Cell.ColumnParity - 1u : Cell.ValueIndex;
	const uint UpIndex = bHasUp ? Cell.NeighborBase + HalfRowCellCount : Cell.ValueIndex;
	const uint DownIndex = bHasDown ? Cell.NeighborBase - HalfRowCellCount : Cell.ValueIndex;
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	const bool bIsFluid = SharedFluidCell[Cell.ValueIndex] != 0u;
	const float RightAperture = (bIsFluid && bHasRight && SharedFluidCell[RightIndex] != 0u) ? 1.0f : 0.0f;
	const float LeftAperture = (bIsFluid && bHasLeft && SharedFluidCell[LeftIndex] != 0u) ? 1.0f : 0.0f;
	const float UpAperture = (bIsFluid && bHasUp && SharedFluidCell[UpIndex] != 0u) ? 1.0f : 0.0f;
	const float DownAperture = (bIsFluid && bHasDown && SharedFluidCell[DownIndex] != 0u) ? 1.0f : 0.0f;
	float Divergence = 0.0f;
	if (bIsFluid && Cell.WindowMargin >= 1)
	{
		Divergence = (SharedVelocityX[RightIndex] - SharedVelocityX[LeftIndex]) / (2.0f * Actor.RelativeCellSpacing.x) + (SharedVelocityY[UpIndex] - SharedVelocityY[DownIndex]) / (2.0f * Actor.RelativeCellSpacing.y);
	}
	Cell.Rhs = Divergence;
#else
	const float RightAperture = SharedApertureX[Cell.ValueIndex];
	const float LeftAperture = bHasLeft ? SharedApertureX[LeftIndex] : 0.0f;
	const float UpAperture = SharedApertureY[Cell.ValueIndex];
	const float DownAperture = bHasDown ? SharedApertureY[DownIndex] : 0.0f;
	Cell.Rhs = SharedRhs[Cell.ValueIndex];
#endif
	Cell.bIsActive = (RightAperture + UpAperture) + (LeftAperture + DownAperture) > 0.0f;
	Cell.RightWeight = RightAperture * Weights.x;
	Cell.LeftWeight = LeftAperture * Weights.x;
	Cell.UpWeight = UpAperture * Weights.y;
	Cell.DownWeight = DownAperture * Weights.y;
	Cell.Diagonal = (Cell.RightWeight + Cell.LeftWeight) + (Cell.UpWeight + Cell.DownWeight);
	return Cell;
}

void RelaxOwnedCell(FTDFluidGpuMultigridOwnedCell Cell, int RegionSize, int WindowMargin)
{
	if (!Cell.bIsOwned || Cell.WindowMargin < WindowMargin || !(Cell.Diagonal > 0.0f))
	{
		return;
	}

	const uint HalfRowCellCount = uint(RegionSize / 2);
	const float NeighborSum = (Cell.RightWeight * SharedValue[Cell.NeighborBase + Cell.ColumnParity] + Cell.LeftWeight * SharedValue[Cell.NeighborBase + Cell.ColumnParity - 1u])
		+ (Cell.UpWeight * SharedValue[Cell.NeighborBase + HalfRowCellCount] + Cell.DownWeight * SharedValue[Cell.NeighborBase - HalfRowCellCount]);
	SharedValue[Cell.ValueIndex] = (NeighborSum - Cell.Rhs) / Cell.Diagonal;
}

float ComputeOwnedResidual(FTDFluidGpuMultigridOwnedCell Cell, int RegionSize)
{
	if (!(Cell.Diagonal > 0.0f))
	{
		return 0.0f;
	}

	const uint HalfRowCellCount = uint(RegionSize / 2);
	const float CenterValue = SharedValue[Cell.ValueIndex];
	const float AppliedOperator = (Cell.RightWeight * (SharedValue[Cell.NeighborBase + Cell.ColumnParity] - CenterValue) + Cell.LeftWeight * (SharedValue[Cell.NeighborBase + Cell.ColumnParity - 1u] - CenterValue))
		+ (Cell.UpWeight * (SharedValue[Cell.NeighborBase + HalfRowCellCount] - CenterValue) + Cell.DownWeight * (SharedValue[Cell.NeighborBase - HalfRowCellCount] - CenterValue));
	return Cell.Rhs - AppliedOperator;
}

float ReadRegionApertureX(int2 LocalCell, int RegionSize)
{
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	const bool bIsOpen = SharedFluidCell[ToColorSplitIndex(LocalCell, RegionSize)] != 0u && SharedFluidCell[ToColorSplitIndex(LocalCell + int2(1, 0), RegionSize)] != 0u;
	return bIsOpen ? 1.0f : 0.0f;
#else
	return SharedApertureX[ToColorSplitIndex(LocalCell, RegionSize)];
#endif
}

float ReadRegionApertureY(int2 LocalCell, int RegionSize)
{
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	const bool bIsOpen = SharedFluidCell[ToColorSplitIndex(LocalCell, RegionSize)] != 0u && SharedFluidCell[ToColorSplitIndex(LocalCell + int2(0, 1), RegionSize)] != 0u;
	return bIsOpen ? 1.0f : 0.0f;
#else
	return SharedApertureY[ToColorSplitIndex(LocalCell, RegionSize)];
#endif
}

[numthreads(TDFLUIDGPU_TILE_GROUP_SIZE, TDFLUIDGPU_TILE_GROUP_SIZE, 1)]
void MultigridDownCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const uint EntryIndex = GroupId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const float2 Weights = ComputeLevelWeights(Actor);
	const int2 TileOrigin = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE;
	const int2 RegionOrigin = TileOrigin - TDFLUIDGPU_MG_DOWN_HALO_CELLS;

	LoadRegion(Actor, EntryIndex, RegionOrigin, TDFLUIDGPU_MG_DOWN_REGION, TDFLUIDGPU_MG_IS_FINEST_LEVEL != 0, WarmStartScale, GroupIndex, TDFLUIDGPU_MG_THREAD_COUNT);
	GroupMemoryBarrierWithGroupSync();

	FTDFluidGpuMultigridOwnedCell OwnedCells[2 * TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT];
	[unroll]
	for (uint OwnedIndex = 0; OwnedIndex < 2 * TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT; ++OwnedIndex)
	{
		OwnedCells[OwnedIndex] = MakeOwnedCell(Actor, Weights, TDFLUIDGPU_MG_DOWN_REGION, OwnedIndex / TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT, OwnedIndex % TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT, GroupIndex, TDFLUIDGPU_MG_THREAD_COUNT);
	}

	[unroll]
	for (uint HalfSweep = 0; HalfSweep < TDFLUIDGPU_MG_DOWN_HALF_SWEEP_COUNT; ++HalfSweep)
	{
		const uint Color = HalfSweep & 1u;
		[unroll]
		for (uint Slot = 0; Slot < TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT; ++Slot)
		{
			RelaxOwnedCell(OwnedCells[Color * TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT + Slot], TDFLUIDGPU_MG_DOWN_REGION, int(HalfSweep) + 1);
		}
		GroupMemoryBarrierWithGroupSync();
	}

	[unroll]
	for (uint ResidualIndex = 0; ResidualIndex < 2 * TDFLUIDGPU_MG_DOWN_OWNED_SLOT_COUNT; ++ResidualIndex)
	{
		const FTDFluidGpuMultigridOwnedCell OwnedCell = OwnedCells[ResidualIndex];
		if (OwnedCell.bIsOwned && OwnedCell.WindowMargin >= TDFLUIDGPU_MG_DOWN_HALO_CELLS)
		{
			const int2 TileCell = OwnedCell.LocalCell - TDFLUIDGPU_MG_DOWN_HALO_CELLS;
			SharedResidual[TileCell.y * TDFLUIDGPU_TILE_GROUP_SIZE + TileCell.x] = ComputeOwnedResidual(OwnedCell, TDFLUIDGPU_MG_DOWN_REGION);
		}
	}
	const int2 Cell = TileOrigin + int2(GroupThreadId.xy);
	ValueOut[TDFluidGpuMakeTexel(Cell, GetLevelSlice(Actor, EntryIndex))] = SharedValue[ToColorSplitIndex(int2(GroupThreadId.xy) + TDFLUIDGPU_MG_DOWN_HALO_CELLS, TDFLUIDGPU_MG_DOWN_REGION)];
	GroupMemoryBarrierWithGroupSync();

	if (any(GroupThreadId.xy >= TDFLUIDGPU_TILE_GROUP_SIZE / 2))
	{
		return;
	}

	const uint2 ChildOrigin = GroupThreadId.xy * 2u;
	const uint ChildIndex = ChildOrigin.y * TDFLUIDGPU_TILE_GROUP_SIZE + ChildOrigin.x;
	const float LowerResidualSum = SharedResidual[ChildIndex] + SharedResidual[ChildIndex + 1u];
	const float UpperResidualSum = SharedResidual[ChildIndex + TDFLUIDGPU_TILE_GROUP_SIZE] + SharedResidual[ChildIndex + TDFLUIDGPU_TILE_GROUP_SIZE + 1u];
	const uint3 CoarseTexel = uint3(uint2(TileOrigin / 2) + GroupThreadId.xy, EntryIndex);
	CoarseRhsOut[CoarseTexel] = 0.25f * (LowerResidualSum + UpperResidualSum);

#if TDFLUIDGPU_MG_WRITES_COARSE_APERTURES
	const int2 ChildLocalCell = int2(ChildOrigin) + TDFLUIDGPU_MG_DOWN_HALO_CELLS;
	const float CoarseApertureX = 0.5f * (ReadRegionApertureX(ChildLocalCell + int2(1, 0), TDFLUIDGPU_MG_DOWN_REGION) + ReadRegionApertureX(ChildLocalCell + int2(1, 1), TDFLUIDGPU_MG_DOWN_REGION));
	const float CoarseApertureY = 0.5f * (ReadRegionApertureY(ChildLocalCell + int2(0, 1), TDFLUIDGPU_MG_DOWN_REGION) + ReadRegionApertureY(ChildLocalCell + int2(1, 1), TDFLUIDGPU_MG_DOWN_REGION));
	CoarseAperturesOut[CoarseTexel] = float2(CoarseApertureX, CoarseApertureY);
#endif
}

uint ToCoarseFootprintIndex(int2 CoarseLocalCell)
{
	return uint(CoarseLocalCell.y * TDFLUIDGPU_MG_COARSE_FOOTPRINT + CoarseLocalCell.x);
}

bool IsCoarseFaceOpenAlongX(int2 LeftCoarseLocalCell)
{
	return SharedCoarseApertures[ToCoarseFootprintIndex(LeftCoarseLocalCell)].x > 0.0f;
}

bool IsCoarseFaceOpenAlongY(int2 LowerCoarseLocalCell)
{
	return SharedCoarseApertures[ToCoarseFootprintIndex(LowerCoarseLocalCell)].y > 0.0f;
}

float ComputeProlongedCorrection(int2 Cell, int2 CoarseOrigin)
{
	const int2 Parent = (Cell >> 1) - CoarseOrigin;
	const int2 Step = int2((Cell.x & 1) != 0 ? 1 : -1, (Cell.y & 1) != 0 ? 1 : -1);
	const int2 NeighborX = Parent + int2(Step.x, 0);
	const int2 NeighborY = Parent + int2(0, Step.y);
	const int2 NeighborDiagonal = Parent + Step;
	const bool bUsesNeighborX = IsCoarseFaceOpenAlongX(Step.x > 0 ? Parent : NeighborX);
	const bool bUsesNeighborY = IsCoarseFaceOpenAlongY(Step.y > 0 ? Parent : NeighborY);
	const bool bReachesDiagonal = IsCoarseFaceOpenAlongY(Step.y > 0 ? NeighborX : NeighborDiagonal) || IsCoarseFaceOpenAlongX(Step.x > 0 ? NeighborY : NeighborDiagonal);

	float WeightedSum = 9.0f * SharedCoarseCorrection[ToCoarseFootprintIndex(Parent)];
	float WeightSum = 9.0f;
	if (bUsesNeighborX)
	{
		WeightedSum += 3.0f * SharedCoarseCorrection[ToCoarseFootprintIndex(NeighborX)];
		WeightSum += 3.0f;
	}
	if (bUsesNeighborY)
	{
		WeightedSum += 3.0f * SharedCoarseCorrection[ToCoarseFootprintIndex(NeighborY)];
		WeightSum += 3.0f;
	}
	if (bUsesNeighborX && bUsesNeighborY && bReachesDiagonal)
	{
		WeightedSum += SharedCoarseCorrection[ToCoarseFootprintIndex(NeighborDiagonal)];
		WeightSum += 1.0f;
	}
	return WeightedSum / WeightSum;
}

[numthreads(TDFLUIDGPU_MG_UP_THREAD_COUNT, 1, 1)]
void MultigridUpCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint EntryIndex = GroupId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const float2 Weights = ComputeLevelWeights(Actor);
	const int2 TileOrigin = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE;
	const int2 RegionOrigin = TileOrigin - TDFLUIDGPU_MG_UP_HALO_CELLS;
	const int2 CoarseOrigin = TileOrigin / 2 - TDFLUIDGPU_MG_COARSE_FOOTPRINT_MARGIN;

	LoadRegion(Actor, EntryIndex, RegionOrigin, TDFLUIDGPU_MG_UP_REGION, true, 1.0f, GroupIndex, TDFLUIDGPU_MG_UP_THREAD_COUNT);
	const int2 TileCell = int2(GroupIndex % TDFLUIDGPU_TILE_GROUP_SIZE, GroupIndex / TDFLUIDGPU_TILE_GROUP_SIZE);
	const bool bOwnsTileCell = GroupIndex < TDFLUIDGPU_MG_THREAD_COUNT;
	const int2 CoarseCell = CoarseOrigin + TileCell;
	float CoarseCorrection = 0.0f;
	float2 CoarseApertures = float2(0.0f, 0.0f);
	if (TDFluidGpuIsInsideGrid(CoarseCell, LevelResolution / 2))
	{
		const uint3 CoarseTexel = TDFluidGpuMakeTexel(CoarseCell, int(EntryIndex));
		CoarseCorrection = CoarseCorrectionIn[CoarseTexel];
		CoarseApertures = CoarseAperturesIn[CoarseTexel];
	}
	if (bOwnsTileCell)
	{
		SharedCoarseCorrection[GroupIndex] = CoarseCorrection;
		SharedCoarseApertures[GroupIndex] = CoarseApertures;
	}
	GroupMemoryBarrierWithGroupSync();

	FTDFluidGpuMultigridOwnedCell OwnedCells[2 * TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT];
	[unroll]
	for (uint OwnedIndex = 0; OwnedIndex < 2 * TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT; ++OwnedIndex)
	{
		const FTDFluidGpuMultigridOwnedCell OwnedCell = MakeOwnedCell(Actor, Weights, TDFLUIDGPU_MG_UP_REGION, OwnedIndex / TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT, OwnedIndex % TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT, GroupIndex, TDFLUIDGPU_MG_UP_THREAD_COUNT);
		if (OwnedCell.bIsOwned && OwnedCell.bIsActive)
		{
			SharedValue[OwnedCell.ValueIndex] += ComputeProlongedCorrection(RegionOrigin + OwnedCell.LocalCell, CoarseOrigin);
		}
		OwnedCells[OwnedIndex] = OwnedCell;
	}
	GroupMemoryBarrierWithGroupSync();

	[unroll]
	for (uint HalfSweep = 0; HalfSweep < TDFLUIDGPU_MG_UP_HALF_SWEEP_COUNT; ++HalfSweep)
	{
		const uint Color = 1u - (HalfSweep & 1u);
		[unroll]
		for (uint Slot = 0; Slot < TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT; ++Slot)
		{
			RelaxOwnedCell(OwnedCells[Color * TDFLUIDGPU_MG_UP_OWNED_SLOT_COUNT + Slot], TDFLUIDGPU_MG_UP_REGION, int(HalfSweep) + 1);
		}
		GroupMemoryBarrierWithGroupSync();
	}

	const uint TileValueIndex = ToColorSplitIndex(TileCell + TDFLUIDGPU_MG_UP_HALO_CELLS, TDFLUIDGPU_MG_UP_REGION);
	const float Value = SharedValue[TileValueIndex];
	const int2 Cell = TileOrigin + TileCell;
	const float FiniteValue = isfinite(Value) ? Value : 0.0f;
#if TDFLUIDGPU_MG_IS_FINEST_LEVEL
	const float OutputValue = clamp(FiniteValue, -TDFLUIDGPU_MG_PRESSURE_LIMIT, TDFLUIDGPU_MG_PRESSURE_LIMIT);
#else
	const float OutputValue = FiniteValue;
#endif
	if (bOwnsTileCell)
	{
		ValueOut[TDFluidGpuMakeTexel(Cell, GetLevelSlice(Actor, EntryIndex))] = OutputValue;
	}

#if TDFLUIDGPU_MG_REDUCES_PRESSURE_SUMS
	if (bOwnsTileCell)
	{
		SharedPressureSums[GroupIndex] = SharedFluidCell[TileValueIndex] != 0u ? float2(OutputValue, 1.0f) : float2(0.0f, 0.0f);
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex < TDFLUIDGPU_TILE_GROUP_SIZE)
	{
		float2 ColumnSum = float2(0.0f, 0.0f);
		[unroll]
		for (uint Row = 0; Row < TDFLUIDGPU_TILE_GROUP_SIZE; ++Row)
		{
			ColumnSum += SharedPressureSums[Row * TDFLUIDGPU_TILE_GROUP_SIZE + GroupIndex];
		}
		SharedPressureColumnSums[GroupIndex] = ColumnSum;
	}
	GroupMemoryBarrierWithGroupSync();

	if (GroupIndex == 0u)
	{
		float2 TileSum = float2(0.0f, 0.0f);
		[unroll]
		for (uint Column = 0; Column < TDFLUIDGPU_TILE_GROUP_SIZE; ++Column)
		{
			TileSum += SharedPressureColumnSums[Column];
		}
		PressurePartialSumsOut[GroupId.z * TilesPerSlice + GroupId.y * TilesPerRow + GroupId.x] = TileSum;
	}
#endif
}

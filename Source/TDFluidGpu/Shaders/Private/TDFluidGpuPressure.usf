#include "/TDFluidGpu/Private/TDFluidGpuCommon.ush"

#ifndef TDFLUIDGPU_COMPUTES_DIVERGENCE
#define TDFLUIDGPU_COMPUTES_DIVERGENCE 0
#endif

#ifndef TDFLUIDGPU_MEAN_PHASE
#define TDFLUIDGPU_MEAN_PHASE 0
#endif

#define TDFLUIDGPU_JACOBI_HALO_CELLS 4
#define TDFLUIDGPU_JACOBI_REGION (TDFLUIDGPU_TILE_GROUP_SIZE + 2 * TDFLUIDGPU_JACOBI_HALO_CELLS)
#define TDFLUIDGPU_JACOBI_REGION_CELL_COUNT (TDFLUIDGPU_JACOBI_REGION * TDFLUIDGPU_JACOBI_REGION)
#define TDFLUIDGPU_TILE_THREAD_COUNT (TDFLUIDGPU_TILE_GROUP_SIZE * TDFLUIDGPU_TILE_GROUP_SIZE)

Texture2DArray<float> ObstacleSdf;
Texture2DArray<float2> VelocityIn;
Texture2DArray<float> DivergenceIn;
RWTexture2DArray<float> DivergenceOut;
Texture2DArray<float> PressureIn;
RWTexture2DArray<float> PressureOut;
RWTexture2DArray<float2> VelocityOut;
StructuredBuffer<float2> PressurePartialSumsIn;
RWStructuredBuffer<float2> PressurePartialSumsOut;
RWStructuredBuffer<float> MeanPressureOut;
uint IterationCount;
uint EnforcesObstacleBoundaries;
uint TilesPerSlice;
uint TilesPerRow;

groupshared float SharedPressure[2 * TDFLUIDGPU_JACOBI_REGION_CELL_COUNT];
groupshared float SharedDivergence[TDFLUIDGPU_JACOBI_REGION_CELL_COUNT];
groupshared uint SharedFluidCell[TDFLUIDGPU_JACOBI_REGION_CELL_COUNT];
groupshared float2 SharedPressureSums[TDFLUIDGPU_TILE_THREAD_COUNT];

bool IsFluidCell(FTDFluidGpuActorParameters Actor, int2 Cell)
{
	return TDFluidGpuIsInsideGrid(Cell, Actor.Resolution) && !TDFluidGpuIsSolidDistance(ObstacleSdf[TDFluidGpuMakeTexel(Cell, Actor.SliceIndex)]);
}

float ComputeCellDivergence(FTDFluidGpuActorParameters Actor, int2 Cell)
{
	const float VelocityRight = IsFluidCell(Actor, Cell + int2(1, 0)) ? VelocityIn[TDFluidGpuMakeTexel(Cell + int2(1, 0), Actor.SliceIndex)].x : 0.0f;
	const float VelocityLeft = IsFluidCell(Actor, Cell - int2(1, 0)) ? VelocityIn[TDFluidGpuMakeTexel(Cell - int2(1, 0), Actor.SliceIndex)].x : 0.0f;
	const float VelocityUp = IsFluidCell(Actor, Cell + int2(0, 1)) ? VelocityIn[TDFluidGpuMakeTexel(Cell + int2(0, 1), Actor.SliceIndex)].y : 0.0f;
	const float VelocityDown = IsFluidCell(Actor, Cell - int2(0, 1)) ? VelocityIn[TDFluidGpuMakeTexel(Cell - int2(0, 1), Actor.SliceIndex)].y : 0.0f;
	return (VelocityRight - VelocityLeft) / (2.0f * Actor.RelativeCellSpacing.x) + (VelocityUp - VelocityDown) / (2.0f * Actor.RelativeCellSpacing.y);
}

uint ToJacobiRegionIndex(int2 LocalCell)
{
	return uint(LocalCell.y * TDFLUIDGPU_JACOBI_REGION + LocalCell.x);
}

[numthreads(TDFLUIDGPU_TILE_GROUP_SIZE, TDFLUIDGPU_TILE_GROUP_SIZE, 1)]
void JacobiTileCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[GroupId.z];
	const int2 TileOrigin = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE;
	const int2 RegionOrigin = TileOrigin - TDFLUIDGPU_JACOBI_HALO_CELLS;

	for (uint RegionIndex = GroupIndex; RegionIndex < TDFLUIDGPU_JACOBI_REGION_CELL_COUNT; RegionIndex += TDFLUIDGPU_TILE_THREAD_COUNT)
	{
		const int2 LocalCell = int2(RegionIndex % TDFLUIDGPU_JACOBI_REGION, RegionIndex / TDFLUIDGPU_JACOBI_REGION);
		const int2 GlobalCell = RegionOrigin + LocalCell;
		const bool bIsFluidCell = IsFluidCell(Actor, GlobalCell);
		float Pressure = 0.0f;
		float Divergence = 0.0f;
		if (bIsFluidCell)
		{
			const uint3 Texel = TDFluidGpuMakeTexel(GlobalCell, Actor.SliceIndex);
			Pressure = PressureIn[Texel];
#if TDFLUIDGPU_COMPUTES_DIVERGENCE
			Divergence = ComputeCellDivergence(Actor, GlobalCell);
#else
			Divergence = DivergenceIn[Texel];
#endif
		}
		SharedFluidCell[RegionIndex] = bIsFluidCell ? 1u : 0u;
		SharedPressure[RegionIndex] = Pressure;
		SharedDivergence[RegionIndex] = Divergence;
	}
	GroupMemoryBarrierWithGroupSync();

	for (uint Iteration = 0; Iteration < IterationCount; ++Iteration)
	{
		const uint SourceOffset = (Iteration & 1u) * TDFLUIDGPU_JACOBI_REGION_CELL_COUNT;
		const uint TargetOffset = TDFLUIDGPU_JACOBI_REGION_CELL_COUNT - SourceOffset;
		const int RegionMin = int(Iteration) + 1;
		const int RegionMax = TDFLUIDGPU_JACOBI_REGION - int(Iteration) - 1;
		for (uint RegionIndex = GroupIndex; RegionIndex < TDFLUIDGPU_JACOBI_REGION_CELL_COUNT; RegionIndex += TDFLUIDGPU_TILE_THREAD_COUNT)
		{
			const int2 LocalCell = int2(RegionIndex % TDFLUIDGPU_JACOBI_REGION, RegionIndex / TDFLUIDGPU_JACOBI_REGION);
			const bool bIsInsideUpdateRegion = LocalCell.x >= RegionMin && LocalCell.y >= RegionMin && LocalCell.x < RegionMax && LocalCell.y < RegionMax;
			if (!bIsInsideUpdateRegion)
			{
				continue;
			}

			if (SharedFluidCell[RegionIndex] == 0u)
			{
				SharedPressure[TargetOffset + RegionIndex] = 0.0f;
				continue;
			}

			const uint RightIndex = ToJacobiRegionIndex(LocalCell + int2(1, 0));
			const uint LeftIndex = ToJacobiRegionIndex(LocalCell - int2(1, 0));
			const uint UpIndex = ToJacobiRegionIndex(LocalCell + int2(0, 1));
			const uint DownIndex = ToJacobiRegionIndex(LocalCell - int2(0, 1));
			const float CenterPressure = SharedPressure[SourceOffset + RegionIndex];
			const float PressureRight = SharedFluidCell[RightIndex] != 0u ? SharedPressure[SourceOffset + RightIndex] : CenterPressure;
			const float PressureLeft = SharedFluidCell[LeftIndex] != 0u ? SharedPressure[SourceOffset + LeftIndex] : CenterPressure;
			const float PressureUp = SharedFluidCell[UpIndex] != 0u ? SharedPressure[SourceOffset + UpIndex] : CenterPressure;
			const float PressureDown = SharedFluidCell[DownIndex] != 0u ? SharedPressure[SourceOffset + DownIndex] : CenterPressure;
			SharedPressure[TargetOffset + RegionIndex] = ((PressureLeft + PressureRight) * Actor.InvSpacingXSquared + (PressureDown + PressureUp) * Actor.InvSpacingYSquared - SharedDivergence[RegionIndex]) * Actor.InvNeighborWeightSum;
		}
		GroupMemoryBarrierWithGroupSync();
	}

	const int2 Cell = TileOrigin + int2(GroupThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint ResultOffset = (IterationCount & 1u) * TDFLUIDGPU_JACOBI_REGION_CELL_COUNT;
	const uint CenterIndex = ToJacobiRegionIndex(int2(GroupThreadId.xy) + TDFLUIDGPU_JACOBI_HALO_CELLS);
	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	PressureOut[Texel] = SharedPressure[ResultOffset + CenterIndex];
#if TDFLUIDGPU_COMPUTES_DIVERGENCE
	DivergenceOut[Texel] = SharedDivergence[CenterIndex];
#endif
}

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void SubtractGradientCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[DispatchThreadId.z];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	if (!IsFluidCell(Actor, Cell))
	{
		VelocityOut[Texel] = float2(0.0f, 0.0f);
		return;
	}

	const float CenterPressure = PressureIn[Texel];
	const float PressureRight = IsFluidCell(Actor, Cell + int2(1, 0)) ? PressureIn[TDFluidGpuMakeTexel(Cell + int2(1, 0), Actor.SliceIndex)] : CenterPressure;
	const float PressureLeft = IsFluidCell(Actor, Cell - int2(1, 0)) ? PressureIn[TDFluidGpuMakeTexel(Cell - int2(1, 0), Actor.SliceIndex)] : CenterPressure;
	const float PressureUp = IsFluidCell(Actor, Cell + int2(0, 1)) ? PressureIn[TDFluidGpuMakeTexel(Cell + int2(0, 1), Actor.SliceIndex)] : CenterPressure;
	const float PressureDown = IsFluidCell(Actor, Cell - int2(0, 1)) ? PressureIn[TDFluidGpuMakeTexel(Cell - int2(0, 1), Actor.SliceIndex)] : CenterPressure;

	float2 Velocity = VelocityIn[Texel];
	Velocity.x -= (PressureRight - PressureLeft) / (2.0f * Actor.RelativeCellSpacing.x);
	Velocity.y -= (PressureUp - PressureDown) / (2.0f * Actor.RelativeCellSpacing.y);
	if (EnforcesObstacleBoundaries != 0u)
	{
		Velocity = TDFluidGpuEnforceObstacleBoundary(ObstacleSdf, Actor, Cell, Velocity);
	}
	VelocityOut[Texel] = Velocity;
}

void ReduceSharedPressureSums(uint GroupIndex)
{
	for (uint Stride = TDFLUIDGPU_TILE_THREAD_COUNT / 2u; Stride > 0u; Stride >>= 1u)
	{
		if (GroupIndex < Stride)
		{
			SharedPressureSums[GroupIndex] += SharedPressureSums[GroupIndex + Stride];
		}
		GroupMemoryBarrierWithGroupSync();
	}
}

#if TDFLUIDGPU_MEAN_PHASE == 0

[numthreads(TDFLUIDGPU_TILE_GROUP_SIZE, TDFLUIDGPU_TILE_GROUP_SIZE, 1)]
void PressureMeanCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[GroupId.z];
	const int2 Cell = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE + int2(GroupThreadId.xy);
	float2 PressureSum = float2(0.0f, 0.0f);
	if (IsFluidCell(Actor, Cell))
	{
		PressureSum = float2(PressureIn[TDFluidGpuMakeTexel(Cell, Actor.SliceIndex)], 1.0f);
	}
	SharedPressureSums[GroupIndex] = PressureSum;
	GroupMemoryBarrierWithGroupSync();

	ReduceSharedPressureSums(GroupIndex);
	if (GroupIndex == 0u)
	{
		PressurePartialSumsOut[GroupId.z * TilesPerSlice + GroupId.y * TilesPerRow + GroupId.x] = SharedPressureSums[0];
	}
}

#else

[numthreads(TDFLUIDGPU_TILE_THREAD_COUNT, 1, 1)]
void PressureMeanCS(uint3 GroupId : SV_GroupID, uint GroupIndex : SV_GroupIndex)
{
	const uint EntryIndex = GroupId.z;
	float2 PressureSum = float2(0.0f, 0.0f);
	for (uint TileIndex = GroupIndex; TileIndex < TilesPerSlice; TileIndex += TDFLUIDGPU_TILE_THREAD_COUNT)
	{
		PressureSum += PressurePartialSumsIn[EntryIndex * TilesPerSlice + TileIndex];
	}
	SharedPressureSums[GroupIndex] = PressureSum;
	GroupMemoryBarrierWithGroupSync();

	ReduceSharedPressureSums(GroupIndex);
	if (GroupIndex == 0u)
	{
		const float2 TotalSum = SharedPressureSums[0];
		MeanPressureOut[EntryIndex] = TotalSum.y > 0.0f ? TotalSum.x / TotalSum.y : 0.0f;
	}
}

#endif

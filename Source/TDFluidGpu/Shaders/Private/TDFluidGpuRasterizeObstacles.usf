#include "/TDFluidGpu/Private/TDFluidGpuCommon.ush"

#ifndef TDFLUIDGPU_FIELD_INPUT
#define TDFLUIDGPU_FIELD_INPUT 0
#endif

#if TDFLUIDGPU_FIELD_INPUT
#include "/TDFluidGpu/Private/TDFluidGpuFieldInput.ush"
#endif

StructuredBuffer<uint> EntryList;
RWTexture2DArray<float> ObstacleSdfOut;

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void MainCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryList[DispatchThreadId.z]];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	float SignedDistance = TDFluidGpuComputeObstacleSignedDistance(Actor, Cell);
#if TDFLUIDGPU_FIELD_INPUT
	SignedDistance = min(SignedDistance, TDFluidGpuComputeFieldCollisionDistance(Actor, EntryList[DispatchThreadId.z], Cell));
#endif
	ObstacleSdfOut[TDFluidGpuMakeTexel(Cell, Actor.SliceIndex)] = SignedDistance;
}

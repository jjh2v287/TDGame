#include "/TDFluidGpu/Private/TDFluidGpuWaterCommon.ush"

#ifndef TDFLUIDGPU_WATER_SOLID_FIRST_READS
#define TDFLUIDGPU_WATER_SOLID_FIRST_READS 0
#endif

StructuredBuffer<float> StampRippleImpulses;
StructuredBuffer<FTDFluidGpuPackedRingShape> StampRingShapes;
Texture2DArray<float> CompositeSdf;
Texture2DArray<float4> WaterGuideField;
Texture2DArray<float> WaterSurfaceHeightField;
Texture2DArray<float> WaterTerrainField;
Texture2DArray<float2> VelocityIn;
Texture2DArray<float2> DensityIn;
Texture2DArray<float2> RippleIn;
RWTexture2DArray<float2> VelocityOut;
RWTexture2DArray<float2> DensityOut;
RWTexture2DArray<float2> RippleOut;

float TDFluidGpuWaterComputeRingDensityWeight(FTDFluidGpuPackedRingShape RingShape, float2 OffsetFromCenter, float DistanceCm, float EffectiveRadiusCm)
{
	const float InnerRadiusCm = RingShape.InnerRadiusRatio * EffectiveRadiusCm;
	const float CenterRadiusCm = 0.5f * (InnerRadiusCm + EffectiveRadiusCm);
	const float HalfWidthCm = max(0.5f * (EffectiveRadiusCm - InnerRadiusCm), TDFLUIDGPU_KINDA_SMALL_NUMBER);
	const float BandFalloff = saturate(1.0f - abs(DistanceCm - CenterRadiusCm) / HalfWidthCm);
	const float BandWeight = BandFalloff * BandFalloff * (3.0f - 2.0f * BandFalloff);
	if (all(RingShape.MotionDirection == 0.0f) || !(DistanceCm > TDFLUIDGPU_KINDA_SMALL_NUMBER))
	{
		return BandWeight;
	}

	return BandWeight * saturate(RingShape.SideArcWeight + dot(OffsetFromCenter / DistanceCm, RingShape.MotionDirection));
}

float TDFluidGpuWaterComputeRingInnerRetain(FTDFluidGpuActorParameters Actor, FTDFluidGpuPackedRingShape RingShape, float DistanceCm, float EffectiveRadiusCm)
{
	const float InnerRadiusCm = RingShape.InnerRadiusRatio * EffectiveRadiusCm;
	if (RingShape.InnerEraseRatePerSec <= 0.0f || DistanceCm >= InnerRadiusCm)
	{
		return 1.0f;
	}

	const float InnerFalloff = 1.0f - DistanceCm / InnerRadiusCm;
	return exp(-RingShape.InnerEraseRatePerSec * InnerFalloff * InnerFalloff * (3.0f - 2.0f * InnerFalloff) * Actor.StampDeltaTimeSeconds);
}

void ApplyWaterRingStampDensity(FTDFluidGpuActorParameters Actor, FTDFluidGpuPackedStamp Stamp, FTDFluidGpuPackedRingShape RingShape, float2 CellCenter, float DistanceCm, inout float2 Density)
{
	float DiscardedDisplacement = 0.0f;
	const float RingWeight = TDFluidGpuWaterComputeRingDensityWeight(RingShape, CellCenter - Stamp.CenterFromWindowCenterCm, DistanceCm, Stamp.EffectiveRadiusCm);
	TDFluidGpuApplyStampDensity(Actor, Stamp, RingWeight, Density, DiscardedDisplacement);
	const float RetainFactor = TDFluidGpuWaterComputeRingInnerRetain(Actor, RingShape, DistanceCm, Stamp.EffectiveRadiusCm);
	Density.x *= RetainFactor;
	if (TDFluidGpuHasStampFlag(Stamp, TDFLUIDGPU_STAMP_FLAG_WRITES_SELECTIVE_DENSITY))
	{
		Density.y *= RetainFactor;
	}
}

void ApplyWaterStampsToCell(FTDFluidGpuActorParameters Actor, int2 Cell, inout float2 Velocity, inout float2 Density, inout float RippleHeight)
{
	const FTDFluidGpuStampBinRange Range = TDFluidGpuGetStampBinRange(Actor, Cell);
	const float2 CellCenter = TDFluidGpuComputeCellCenterFromWindowCenter(Actor, Cell);
	for (uint EntryOffset = 0; EntryOffset < Range.Count; ++EntryOffset)
	{
		const uint StampIndex = StampBinIndices[Range.FirstIndex + EntryOffset];
		const FTDFluidGpuPackedStamp Stamp = Stamps[StampIndex];
		float SmoothWeight;
		float DistanceCm;
		if (!TDFluidGpuTryComputeStampWeight(Stamp, CellCenter, SmoothWeight, DistanceCm))
		{
			continue;
		}

		const FTDFluidGpuPackedRingShape RingShape = StampRingShapes[StampIndex];
		if (RingShape.InnerRadiusRatio > 0.0f && !TDFluidGpuHasStampFlag(Stamp, TDFLUIDGPU_STAMP_FLAG_ERASES_DENSITY))
		{
			ApplyWaterRingStampDensity(Actor, Stamp, RingShape, CellCenter, DistanceCm, Density);
		}
		else
		{
			float DiscardedDisplacement = 0.0f;
			TDFluidGpuApplyStampDensity(Actor, Stamp, SmoothWeight, Density, DiscardedDisplacement);
		}
		if (Stamp.VelocityStrength > 0.0f)
		{
			Velocity += (Stamp.TargetVelocityCmPerSec - Velocity) * (SmoothWeight * Actor.StampVelocityBlend);
		}
		RippleHeight -= StampRippleImpulses[StampIndex] * SmoothWeight;
	}
}

bool ShouldSeedWaterVelocity(FTDFluidGpuActorParameters Actor, FTDFluidGpuWaterParameters Water, int2 Cell)
{
	if (TDFluidGpuWaterHasFlag(Water, TDFLUIDGPU_WATER_FLAG_INITIALIZES_ALL_VELOCITIES))
	{
		return true;
	}

	return TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_HAS_SHIFT) && !TDFluidGpuIsInsideGrid(Cell + Actor.ShiftCells, Actor.Resolution);
}

struct FTDFluidGpuWaterStampedCell
{
	float2 Velocity;
	float2 Density;
	float2 Ripple;
	bool bIsSolid;
};

FTDFluidGpuWaterStampedCell ComputeWaterStampedCell(FTDFluidGpuActorParameters Actor, FTDFluidGpuWaterParameters Water, int2 Cell)
{
	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	float2 Ripple = RippleIn[Texel];
	FTDFluidGpuWaterStampedCell Stamped;
	Stamped.bIsSolid = TDFluidGpuIsSolidDistance(CompositeSdf[Texel]);
	Stamped.Velocity = float2(0.0f, 0.0f);
	Stamped.Density = float2(0.0f, 0.0f);
	Stamped.Ripple = Ripple;
	if (Stamped.bIsSolid)
	{
		return Stamped;
	}

	float2 Velocity = TDFluidGpuClampVelocityMagnitude(VelocityIn[Texel], Actor.MaxCellSpeedCmPerSec);
	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_RASTERIZES_OBSTACLES))
	{
		Velocity = TDFluidGpuEnforceObstacleBoundary(CompositeSdf, Actor, Cell, Velocity);
	}

	float2 Density = DensityIn[Texel];
	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_HAS_STAMPS))
	{
		ApplyWaterStampsToCell(Actor, Cell, Velocity, Density, Ripple.x);
	}

	if (ShouldSeedWaterVelocity(Actor, Water, Cell))
	{
		const float4 Guide = TDFluidGpuWaterLoadGuide(WaterGuideField, Water, Actor, Cell);
		Velocity = Guide.xy * Guide.z;
	}

	Stamped.Velocity = Velocity;
	Stamped.Density = Density;
	Stamped.Ripple = Ripple;
	return Stamped;
}

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void StampsCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint EntryIndex = DispatchThreadId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const FTDFluidGpuWaterParameters Water = WaterParameters[EntryIndex];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	const FTDFluidGpuWaterStampedCell Stamped = ComputeWaterStampedCell(Actor, Water, Cell);
	VelocityOut[Texel] = Stamped.Velocity;
	DensityOut[Texel] = Stamped.Density;
	RippleOut[Texel] = Stamped.Ripple;
}

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void ForcesCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint EntryIndex = DispatchThreadId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const FTDFluidGpuWaterParameters Water = WaterParameters[EntryIndex];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	if (TDFluidGpuIsSolidDistance(CompositeSdf[Texel]))
	{
		VelocityOut[Texel] = float2(0.0f, 0.0f);
		return;
	}

	float2 Velocity = VelocityIn[Texel];
#if !TDFLUIDGPU_WATER_SOLID_FIRST_READS
	const float2 Density = DensityIn[Texel];
#endif
	if (TDFluidGpuWaterHasFlag(Water, TDFLUIDGPU_WATER_FLAG_USES_TERRAIN_SLOPE_DRY_ONLY))
	{
		const float SurfaceHeight = TDFluidGpuWaterLoadSurfaceHeight(WaterSurfaceHeightField, Water, Actor, Cell);
		const float TerrainElevation = TDFluidGpuWaterLoadTerrain(WaterTerrainField, Water, Actor, Cell);
		const bool bIsSubmerged = TDFluidGpuWaterHasSurface(SurfaceHeight) && (!TDFluidGpuIsTerrainElevationKnown(TerrainElevation) || SurfaceHeight > TerrainElevation);
		if (!bIsSubmerged)
		{
#if TDFLUIDGPU_WATER_SOLID_FIRST_READS
			const float2 Density = DensityIn[Texel];
#endif
			const float2 TerrainSlope = TDFluidGpuWaterComputeFieldSlope(WaterTerrainField, Water, Actor, TDFluidGpuWaterToFieldCell(Water, Cell));
			const float ActiveFluidMask = clamp(Density.x + Density.y + 0.1f, 0.0f, 1.0f);
			Velocity -= TerrainSlope * Actor.TerrainSlopeGravity * ActiveFluidMask * Actor.StepDeltaTimeSeconds;
		}
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_FLOW_NOISE))
	{
		Velocity += TDFluidGpuEvaluateFlowNoiseAcceleration(Actor, Cell) * Actor.StepDeltaTimeSeconds;
	}

	if (TDFluidGpuWaterHasFlag(Water, TDFLUIDGPU_WATER_FLAG_USES_FLOW_GUIDES))
	{
		const float4 Guide = TDFluidGpuWaterLoadGuide(WaterGuideField, Water, Actor, Cell);
		if (Guide.z > 0.0f)
		{
			Velocity += (Guide.xy - Velocity) * (Water.FlowGuideResponseBlend * Guide.z);
		}
	}

	VelocityOut[Texel] = TDFluidGpuEnforceObstacleBoundary(CompositeSdf, Actor, Cell, Velocity);
}

float2 ComputeWaterForcedVelocity(FTDFluidGpuActorParameters Actor, FTDFluidGpuWaterParameters Water, int2 Cell, float2 Velocity, float2 Density)
{
	if (TDFluidGpuWaterHasFlag(Water, TDFLUIDGPU_WATER_FLAG_USES_TERRAIN_SLOPE_DRY_ONLY))
	{
		const float SurfaceHeight = TDFluidGpuWaterLoadSurfaceHeight(WaterSurfaceHeightField, Water, Actor, Cell);
		const float TerrainElevation = TDFluidGpuWaterLoadTerrain(WaterTerrainField, Water, Actor, Cell);
		const bool bIsSubmerged = TDFluidGpuWaterHasSurface(SurfaceHeight) && (!TDFluidGpuIsTerrainElevationKnown(TerrainElevation) || SurfaceHeight > TerrainElevation);
		if (!bIsSubmerged)
		{
			const float2 TerrainSlope = TDFluidGpuWaterComputeFieldSlope(WaterTerrainField, Water, Actor, TDFluidGpuWaterToFieldCell(Water, Cell));
			const float ActiveFluidMask = clamp(Density.x + Density.y + 0.1f, 0.0f, 1.0f);
			Velocity -= TerrainSlope * Actor.TerrainSlopeGravity * ActiveFluidMask * Actor.StepDeltaTimeSeconds;
		}
	}

	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_FLOW_NOISE))
	{
		Velocity += TDFluidGpuEvaluateFlowNoiseAcceleration(Actor, Cell) * Actor.StepDeltaTimeSeconds;
	}

	if (TDFluidGpuWaterHasFlag(Water, TDFLUIDGPU_WATER_FLAG_USES_FLOW_GUIDES))
	{
		const float4 Guide = TDFluidGpuWaterLoadGuide(WaterGuideField, Water, Actor, Cell);
		if (Guide.z > 0.0f)
		{
			Velocity += (Guide.xy - Velocity) * (Water.FlowGuideResponseBlend * Guide.z);
		}
	}

	return TDFluidGpuEnforceObstacleBoundary(CompositeSdf, Actor, Cell, Velocity);
}

#define TDFLUIDGPU_WATER_FUSED_HALO_CELLS 2
#define TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE (TDFLUIDGPU_TILE_GROUP_SIZE + 2 * TDFLUIDGPU_WATER_FUSED_HALO_CELLS)
#define TDFLUIDGPU_WATER_FUSED_CURL_TILE (TDFLUIDGPU_TILE_GROUP_SIZE + 2)
#define TDFLUIDGPU_WATER_FUSED_THREAD_COUNT (TDFLUIDGPU_TILE_GROUP_SIZE * TDFLUIDGPU_TILE_GROUP_SIZE)

groupshared float2 SharedFusedVelocity[TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE * TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE];
groupshared float SharedFusedCurl[TDFLUIDGPU_WATER_FUSED_CURL_TILE * TDFLUIDGPU_WATER_FUSED_CURL_TILE];

uint ToFusedVelocityIndex(int2 LocalCell)
{
	return uint(LocalCell.y * TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE + LocalCell.x);
}

uint ToFusedCurlIndex(int2 LocalCell)
{
	return uint(LocalCell.y * TDFLUIDGPU_WATER_FUSED_CURL_TILE + LocalCell.x);
}

bool IsFusedOwnedLocalCell(int2 LocalCell)
{
	return all(LocalCell >= TDFLUIDGPU_WATER_FUSED_HALO_CELLS) && all(LocalCell < TDFLUIDGPU_WATER_FUSED_HALO_CELLS + TDFLUIDGPU_TILE_GROUP_SIZE);
}

[numthreads(TDFLUIDGPU_TILE_GROUP_SIZE, TDFLUIDGPU_TILE_GROUP_SIZE, 1)]
void StampsForcesVorticityCS(uint3 GroupId : SV_GroupID, uint3 GroupThreadId : SV_GroupThreadID, uint GroupIndex : SV_GroupIndex)
{
	const uint EntryIndex = GroupId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const FTDFluidGpuWaterParameters Water = WaterParameters[EntryIndex];
	const int Resolution = Actor.Resolution;
	const int2 TileOrigin = int2(GroupId.xy) * TDFLUIDGPU_TILE_GROUP_SIZE;

	for (uint VelocityIndex = GroupIndex; VelocityIndex < TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE * TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE; VelocityIndex += TDFLUIDGPU_WATER_FUSED_THREAD_COUNT)
	{
		const int2 LocalCell = int2(VelocityIndex % TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE, VelocityIndex / TDFLUIDGPU_WATER_FUSED_VELOCITY_TILE);
		const int2 GlobalCell = TileOrigin - TDFLUIDGPU_WATER_FUSED_HALO_CELLS + LocalCell;
		float2 ForcedVelocity = float2(0.0f, 0.0f);
		if (TDFluidGpuIsInsideGrid(GlobalCell, Resolution))
		{
			const FTDFluidGpuWaterStampedCell Stamped = ComputeWaterStampedCell(Actor, Water, GlobalCell);
			if (!Stamped.bIsSolid)
			{
				ForcedVelocity = ComputeWaterForcedVelocity(Actor, Water, GlobalCell, Stamped.Velocity, Stamped.Density);
			}

			if (IsFusedOwnedLocalCell(LocalCell))
			{
				const uint3 OwnedTexel = TDFluidGpuMakeTexel(GlobalCell, Actor.SliceIndex);
				DensityOut[OwnedTexel] = Stamped.Density;
				RippleOut[OwnedTexel] = Stamped.Ripple;
			}
		}
		SharedFusedVelocity[VelocityIndex] = ForcedVelocity;
	}
	GroupMemoryBarrierWithGroupSync();

	for (uint CurlIndex = GroupIndex; CurlIndex < TDFLUIDGPU_WATER_FUSED_CURL_TILE * TDFLUIDGPU_WATER_FUSED_CURL_TILE; CurlIndex += TDFLUIDGPU_WATER_FUSED_THREAD_COUNT)
	{
		const int2 LocalCell = int2(CurlIndex % TDFLUIDGPU_WATER_FUSED_CURL_TILE, CurlIndex / TDFLUIDGPU_WATER_FUSED_CURL_TILE);
		const int2 GlobalCell = TileOrigin - 1 + LocalCell;
		float Curl = 0.0f;
		const bool bIsInteriorCell = GlobalCell.x >= 1 && GlobalCell.y >= 1 && GlobalCell.x <= Resolution - 2 && GlobalCell.y <= Resolution - 2;
		if (bIsInteriorCell)
		{
			const int2 VelocityCell = LocalCell + 1;
			const float VelocityYRight = SharedFusedVelocity[ToFusedVelocityIndex(VelocityCell + int2(1, 0))].y;
			const float VelocityYLeft = SharedFusedVelocity[ToFusedVelocityIndex(VelocityCell - int2(1, 0))].y;
			const float VelocityXUp = SharedFusedVelocity[ToFusedVelocityIndex(VelocityCell + int2(0, 1))].x;
			const float VelocityXDown = SharedFusedVelocity[ToFusedVelocityIndex(VelocityCell - int2(0, 1))].x;
			const float VelocityYDerivativeX = 0.5f * (VelocityYRight - VelocityYLeft) / Actor.RelativeCellSpacing.x;
			const float VelocityXDerivativeY = 0.5f * (VelocityXUp - VelocityXDown) / Actor.RelativeCellSpacing.y;
			Curl = VelocityYDerivativeX - VelocityXDerivativeY;
		}
		SharedFusedCurl[CurlIndex] = Curl;
	}
	GroupMemoryBarrierWithGroupSync();

	const int2 Cell = TileOrigin + int2(GroupThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Resolution))
	{
		return;
	}

	const int2 LocalVelocityCell = int2(GroupThreadId.xy) + TDFLUIDGPU_WATER_FUSED_HALO_CELLS;
	float2 Velocity = SharedFusedVelocity[ToFusedVelocityIndex(LocalVelocityCell)];
	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	const bool bIsConfinedCell = Cell.x >= 2 && Cell.y >= 2 && Cell.x <= Resolution - 3 && Cell.y <= Resolution - 3;
	if (TDFluidGpuHasActorFlag(Actor, TDFLUIDGPU_ACTOR_FLAG_USES_VORTICITY) && bIsConfinedCell && !TDFluidGpuIsSolidDistance(CompositeSdf[Texel]))
	{
		const int2 LocalCurlCell = int2(GroupThreadId.xy) + 1;
		const float AbsCurlRight = abs(SharedFusedCurl[ToFusedCurlIndex(LocalCurlCell + int2(1, 0))]);
		const float AbsCurlLeft = abs(SharedFusedCurl[ToFusedCurlIndex(LocalCurlCell - int2(1, 0))]);
		const float AbsCurlUp = abs(SharedFusedCurl[ToFusedCurlIndex(LocalCurlCell + int2(0, 1))]);
		const float AbsCurlDown = abs(SharedFusedCurl[ToFusedCurlIndex(LocalCurlCell - int2(0, 1))]);
		float2 CurlGradient = float2(
			0.5f * (AbsCurlRight - AbsCurlLeft) / Actor.RelativeCellSpacing.x,
			0.5f * (AbsCurlUp - AbsCurlDown) / Actor.RelativeCellSpacing.y);
		const float CurlGradientLengthSquared = dot(CurlGradient, CurlGradient);
		if (CurlGradientLengthSquared > TDFLUIDGPU_SMALL_NUMBER)
		{
			CurlGradient *= rsqrt(CurlGradientLengthSquared);
			const float Curl = SharedFusedCurl[ToFusedCurlIndex(LocalCurlCell)];
			Velocity.x += CurlGradient.y * Curl * Actor.VorticityStrength * Actor.StepDeltaTimeSeconds;
			Velocity.y += -CurlGradient.x * Curl * Actor.VorticityStrength * Actor.StepDeltaTimeSeconds;
		}
	}

	VelocityOut[Texel] = Velocity;
}

[numthreads(TDFLUIDGPU_CELL_GROUP_SIZE, TDFLUIDGPU_CELL_GROUP_SIZE, 1)]
void AdvectVelocityCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint EntryIndex = DispatchThreadId.z;
	const FTDFluidGpuActorParameters Actor = ActorParameters[EntryIndex];
	const FTDFluidGpuWaterParameters Water = WaterParameters[EntryIndex];
	const int2 Cell = int2(DispatchThreadId.xy);
	if (!TDFluidGpuIsInsideGrid(Cell, Actor.Resolution))
	{
		return;
	}

	const uint3 Texel = TDFluidGpuMakeTexel(Cell, Actor.SliceIndex);
	if (TDFluidGpuIsSolidDistance(CompositeSdf[Texel]))
	{
		VelocityOut[Texel] = float2(0.0f, 0.0f);
		return;
	}

	const float2 Velocity = VelocityIn[Texel];
	const float2 BacktracePosition = float2(Cell) - Velocity * Actor.AdvectionStepScale;
	const FTDFluidGpuBilinearSample Sample = TDFluidGpuMakeBilinearSample(BacktracePosition, Actor.Resolution);
	const float2 AdvectedVelocity = TDFluidGpuSampleBilinearFloat2(VelocityIn, Sample, Actor.SliceIndex) * Actor.AdvectVelocityDampingFactor;
	const float2 TargetVelocity = TDFluidGpuWaterLoadGuide(WaterGuideField, Water, Actor, Cell).xy;
	const float BorderDamping = TDFluidGpuWaterComputeBorderDamping(Actor, Cell, Actor.StepDeltaTimeSeconds);
	VelocityOut[Texel] = TDFluidGpuEnforceObstacleBoundary(CompositeSdf, Actor, Cell, TargetVelocity + (AdvectedVelocity - TargetVelocity) * BorderDamping);
}

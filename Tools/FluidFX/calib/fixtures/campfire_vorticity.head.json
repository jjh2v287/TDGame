      {"metric": "0.campfire.sil_luma_cv", "weight": 1.0, "tolerance": 0.0026, "basis": "실루엣 안 밝기 변동"},
      {"metric": "0.campfire.sil_hot_frac_L200", "weight": 1.0, "tolerance": 0.0029, "basis": "실루엣 안 밝은 면적 비"}

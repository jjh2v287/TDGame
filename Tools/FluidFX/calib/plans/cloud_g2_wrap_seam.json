{
  "id": "cloud_g2_wrap_seam",
  "note": "FX-11c G2, 셋업 19 WrapField(감싸기 라이브 + 반복 슬롯), 타일 경계 x = 40 km(먼 바닥 위, 지형 끝 x = 20 km 의 지면 이음을 피함) 위에서 아래로. 지표는 경계 좌우 32 px 띠 휘도 차와 주기 자기상관 CAL-0 통합: 목표 측정·결함 계획이라 장면 목표 파일 연결은 0b 측정·승인 뒤 한다(목표를 결과로 정하지 않음, PB2 1절).",
  "scenes": [
    {
      "name": "wrap_seam",
      "level": "/Game/FluidFX/Maps/LV_TDFluidCloudStage",
      "camera": {
        "view_target": "TDGen_CloudCam_WrapField",
        "exposure_ev100": 12.0,
        "console": [
          "TD.FluidFX.CloudSetup 19",
          "TD.FluidFX.CloudViewSampleScale 2",
          "r.TDFogScattering 0",
          "r.VolumetricRenderTarget.Mode 0"
        ]
      },
      "time_dilation": 1.0,
      "settle": 30.0,
      "regions_template": "Tools/FluidFX/calib/regions/cloud_g2_regions.json",
      "live2_refs": [],
      "shots": {
        "count": 3,
        "interval": 0.25,
        "kind": "replicate"
      }
    }
  ],
  "base_tuning": [],
  "params": [
    {
      "json_path": "Kinds.CloudWrapField.TDFluidSimulationConfig.AmbientNoiseAmount",
      "values": [
        0.3,
        0.6,
        0.9
      ]
    },
    {
      "json_path": "Kinds.CloudWrapField.TDFluidSimulationConfig.FlowNoiseAccelerationCmPerSec2",
      "values": [
        20,
        40,
        80
      ]
    },
    {
      "json_path": "Look:Materials./Game/FluidFX/Materials/MI_TD_FluidCloud_WrapField.Scalars.CloudSlot1DetailErosion",
      "values": [
        0.3,
        0.45,
        0.6
      ]
    }
  ],
  "metrics": {
    "sources": [
      "look"
    ],
    "targets": [
      {
        "metric": "derived.seam_band_luminance_delta",
        "weight": 1.0,
        "low": 0.0,
        "high": 0.03
      },
      {
        "metric": "tile.autocorrelation.secondary_peak",
        "weight": 0.5,
        "low": 0.0,
        "high": 0.3
      }
    ],
    "derived": [
      {
        "name": "seam_band_luminance_delta",
        "op": "difference",
        "a": "seam_left.luminance_mean",
        "b": "seam_right.luminance_mean"
      }
    ]
  },
  "mode": "one_at_a_time",
  "repeats": 2,
  "control_every": 0,
  "reset": "reinit"
}

  {
   "json_path": "Globals.TDFluidCloudSceneSettings.PainterBrushRadiusKm",
   "values": [
    0.25,
    0.5,
    1.0
   ]
  },
  {
   "json_path": "Globals.TDFluidCloudSceneSettings.PainterVelocityScale",
   "values": [
    0.5,
    1.0,
    2.0
   ]
  }
 ],
 "metrics": {

    "weight": 1.0,
    "low": 0.5,
    "high": 2.0
   },
   {
    "metric": "painter_stroke.cloud_paint_probe.erased_over_painted",
    "weight": 1.0,
    "low": 0.0,
    "high": 0.6
   }
  ]
 },
 "mode": "one_at_a_time",
 "repeats": 2,
 "control_every": 0,

{
  "id": "cloud_g4_painter",
  "note": "FX-11c G4, 셋업 5 Paint(CloudPaint 라이브 + 칠하기 액터). 의도한 예약: 시작 직후 TD.FluidFX.CloudPaintStroke 6.3 7.7 7.7 6.3 1 0 (카메라 시야 안 평지 사분면을 가로지르는 획 1초), 2초 뒤 같은 획에 지우기 1. 투영 오차 ≤ 1칸은 대본 획이 커서 투영을 건너뛰므로 보정이 아니라 시험 PainterRayToAltitude·PainterDisplayToSimulation 으로 대체한다",
  "scenes": [
    {
      "name": "painter_stroke",
      "level": "/Game/FluidFX/Maps/LV_TDFluidCloudStage",
      "camera": {
        "view_target": "TDGen_CloudCam_Paint",
        "exposure_ev100": 12.0,
        "console": [
          "TD.FluidFX.CloudSetup 5",
          "TD.FluidFX.CloudViewSampleScale 2",
          "TD.FluidFX.CloudPainter 1",
          "r.TDFogScattering 0",
          "r.VolumetricRenderTarget.Mode 0"
        ]
      },
      "time_dilation": 1.0,
      "settle": 4.0,
      "live2_refs": [],
      "sources": [
        "probe"
      ],
      "probe": {
        "times": [
          4.0,
          4.25,
          4.5,
          4.75,
          5.0
        ]
      }
    }
  ],
  "base_tuning": [],
  "params": [
    {
      "json_path": "Globals.TDFluidCloudSceneSettings.PainterBrushRadiusKm",
      "values": [
        0.25,
        0.5,
        1.0
      ]
    },
    {
      "json_path": "Globals.TDFluidCloudSceneSettings.PainterVelocityScale",
      "values": [
        0.5,
        1.0,
        2.0
      ]
    }
  ],
  "metrics": {
    "sources": [
      "probe"
    ],
    "targets": [
      {
        "metric": "probe.cloud_paint.density_in_radius",
        "weight": 1.0,
        "low": 0.5,
        "high": 2.0
      },
      {
        "metric": "probe.cloud_paint.erased_over_painted",
        "weight": 1.0,
        "low": 0.0,
        "high": 0.6
      }
    ]
  },
  "mode": "one_at_a_time",
  "repeats": 2,
  "control_every": 0,
  "reset": "reinit"
